{
    "name": "starcom/starnms",
    "type": "project",
    "description": "NMS Starcom - Universal IP Network Monitoring System",
    "require": {
        "php": "^8.1",
        "ext-snmp": "*",
        "laravel/framework": "^10.0",
        "laravel/tinker": "^2.9",
        "phpoffice/phpspreadsheet": "^5.8",
        "phpoffice/phpword": "^1.3",
        "predis/predis": "2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.15",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#22d3ee,#a78bfa,#fb7185\" \"php artisan serve\" \"php artisan schedule:work\" \"npm run dev\" --names=server,monitor,vite"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
