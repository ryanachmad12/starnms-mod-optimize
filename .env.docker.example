APP_NAME="NMS Starcom"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FORCE_HTTPS=false
APP_VERSION=1.0.0
APP_BUILD_ID=local
APP_RELEASE=2026.09
APP_RELEASE_CHANNEL=Stable
APP_BUILT_AT=2026-09-02
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=starnms
DB_USERNAME=starnms
DB_PASSWORD=change-this-postgres-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
# Keep false only for a temporary HTTP/IP installation. Set true together with
# APP_URL=https://your-domain and FORCE_HTTPS=true after TLS is configured.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
# Set MONITORING_WORKERS=0 to use all available CPU capacity after the reserve.
MONITORING_WORKERS=0
CPU_RESERVE=2
DEFAULT_WORKERS=1
SNMP_WORKERS=2
IMPORT_WORKERS=1
EXPORT_WORKERS=1

POSTGRES_DB=starnms
POSTGRES_USER=starnms
POSTGRES_PASSWORD=change-this-postgres-password
HTTP_PORT=80
REDIS_MAXMEMORY=256mb
BACKUP_HOUR_UTC=2
DAILY_RETENTION_DAYS=14
WEEKLY_RETENTION_WEEKS=8
MONTHLY_RETENTION_MONTHS=12
DEVICE_CHECK_RETENTION_DAYS=90
SNMP_METRIC_RETENTION_DAYS=90
MONITORING_PRUNE_BATCH_SIZE=10000
